# SheetScrape API Environment Variables
# Copy this file to .env and replace with your actual values

# Your secret API key - generate a secure random string
SECRET_API_KEY=your-super-secret-api-key-here

# Port for the API server (default: 8000)
PORT=8000

# Python version (for deployment platforms)
PYTHON_VERSION=3.11.0

# Redis configuration (optional - for caching)
# REDIS_URL=redis://localhost:6379/0 